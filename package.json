{
  "name": "spatial-devex-bridge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,BRIDGE -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:web:xr": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "dev:quest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quest-dev.ps1",
    "dev:xr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quest-lan.ps1",
    "dev:xr:services": "concurrently -k -n WEB,BRIDGE -c cyan,magenta \"npm:dev:web:xr\" \"npm:dev:server\"",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "concurrently -k -n WEB,BRIDGE -c cyan,magenta \"npm:start:web\" \"npm:server\"",
    "start:web": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "server": "node server/index.js",
    "test": "npm run build && node --test server/index.test.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "next": "16.2.12",
    "open": "^11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
